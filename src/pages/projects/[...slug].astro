---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const projects = await getCollection("project");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, tags, videoId, videoPlatform = "youtube", repoUrl } = entry.data;
const embedUrls = {
  youtube: "https://www.youtube-nocookie.com/embed/",
  loom: "https://www.loom.com/embed/",
};
const { Content } = await render(entry);
---

<BaseLayout title={`${title} | Youssef Q`}>
  <Header />
  <main>
    <h2>{title}</h2>
    <ul>
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {
      videoId && (
        <iframe
          src={`${embedUrls[videoPlatform]}${videoId}`}
          title={title}
          allowfullscreen
          loading="lazy"
        />
      )
    }
    <Content />
    {
      repoUrl && (
        <section>
          <h3>GitHub</h3>
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">
            {repoUrl.replace("https://github.com/", "")}
          </a>
        </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 6rem; /* bottom clears the fixed footer */
    color: white;
  }

  main a {
    color: #fcf1d0;
  }

  main a:hover,
  main a:active,
  main a:visited,
  main a:focus-visible {
    color: #8acff8;
  }
  h2 {
    margin: 0 0 0.75rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.75rem;
  }
  iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    margin-bottom: 1.5rem;
  }
</style>
