---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  summary: string;
  thumbnail?: ImageMetadata;
  tags: string[];
  href: string;
}

const { title, summary, thumbnail, tags, href } = Astro.props;
---

<a class="card" href={href}>
  {thumbnail && <Image src={thumbnail} alt={title} />}
  <div class="body">
    <h2>{title}</h2>
    <p>{summary}</p>
    <ul>
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background-color: #010736;
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .card:hover,
  .card:focus-visible {
    color: #8acff8;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    transform: translateY(-4px); /* optional: slight lift */
  }
  img {
    width: 200px;
    height: auto;
    align-self: center; /* horizontal centering in the column */
    margin-top: 0.75rem;
  }
  .body {
    padding: 1rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }
  p {
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.75rem;
  }
</style>
