<canvas id="sand" aria-hidden="true"></canvas>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.6; /* keeps text readable */
  }
</style>

<script>
  // Based on https://cruip.com/how-to-create-a-beautiful-particle-animation-with-html-canvas/
  const canvas = document.getElementById("sand") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const SHADES = ["#e8c07a", "#d9a35b", "#c98a45", "#f0d29a"];
  const STATICITY = 50; // higher = grains follow the cursor less
  const EASE = 75; // higher = smoother cursor follow
  const CLEAR_RADIUS = 100; // px affected by a click
  const EDGE_FADE = 20; // px

  type Grain = {
    x: number;
    y: number; // drift position
    tx: number;
    ty: number; // cursor offset
    vx: number;
    vy: number; // click burst velocity
    dx: number;
    dy: number; // wind drift
    size: number;
    alpha: number;
    targetAlpha: number;
    magnetism: number;
    c: string;
    dying: boolean;
  };

  let w = 0,
    h = 0;
  let grains: Grain[] = [];
  const mouse = { x: 0, y: 0 };

  function createGrain(atLeft = false): Grain {
    return {
      x: atLeft ? 0 : Math.random() * w,
      y: Math.random() * h,
      tx: 0,
      ty: 0,
      vx: 0,
      vy: 0,
      dx: 0.2 + Math.random() * 1.5, // wind drift
      dy: (Math.random() - 0.5) * 0.2,
      size: 1 + Math.floor(Math.random() * 2),
      alpha: 0,
      targetAlpha: 0.3 + Math.random() * 0.6,
      magnetism: 0.1 + Math.random() * 4,
      c: SHADES[Math.floor(Math.random() * SHADES.length)],
      dying: false,
    };
  }

  function resize() {
    const dpr = devicePixelRatio || 1;
    w = innerWidth;
    h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const quantity = Math.min(500, Math.round((w * h) / 2000)); // density
    grains = Array.from({ length: quantity }, () => createGrain());
  }

  const remap = (v: number, a1: number, b1: number, a2: number, b2: number) =>
    Math.max(0, ((v - a1) * (b2 - a2)) / (b1 - a1) + a2);

  function draw() {
    ctx.clearRect(0, 0, w, h);
    grains.forEach((g, i) => {
      g.x += g.dx + g.vx;
      g.y += g.dy + g.vy;
      g.vx *= 0.92;
      g.vy *= 0.92;
      g.tx += (mouse.x / (STATICITY / g.magnetism) - g.tx) / EASE;
      g.ty += (mouse.y / (STATICITY / g.magnetism) - g.ty) / EASE;

      const px = g.x + g.tx,
        py = g.y + g.ty;
      if (g.dying) {
        g.alpha *= 0.9;
        if (g.alpha < 0.01) return (grains[i] = createGrain(true));
      } else {
        const edge = Math.min(px, w - px - g.size, py, h - py - g.size);
        const fade = remap(edge, 0, EDGE_FADE, 0, 1);
        g.alpha =
          fade > 1
            ? Math.min(g.alpha + 0.02, g.targetAlpha)
            : g.targetAlpha * fade;
      }
      if (g.x > w + g.size || g.y < -g.size || g.y > h + g.size)
        return (grains[i] = createGrain(true));

      ctx.globalAlpha = g.alpha;
      ctx.fillStyle = g.c;
      ctx.fillRect(px, py, g.size, g.size); // squares = angular grains
    });
  }

  function loop() {
    draw();
    requestAnimationFrame(loop);
  }

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  function drawStill() {
    grains.forEach((g) => (g.alpha = g.targetAlpha));
    draw();
  }

  resize();
  addEventListener("resize", () => {
    resize();
    if (still) drawStill();
  });
  // The canvas ignores pointer events, so listen on window/body
  addEventListener("pointermove", (e) => {
    mouse.x = e.clientX - w / 2;
    mouse.y = e.clientY - h / 2;
  });
  document.body.addEventListener("click", (e) => {
    for (const g of grains) {
      const ox = g.x + g.tx - e.clientX,
        oy = g.y + g.ty - e.clientY;
      const d = Math.hypot(ox, oy);
      if (d > CLEAR_RADIUS) continue;
      const push = (1 - d / CLEAR_RADIUS) * 6;
      g.vx += (ox / (d || 1)) * push;
      g.vy += (oy / (d || 1)) * push;
      g.dying = true;
    }
  });

  if (still) drawStill();
  else loop();
</script>
