---
const links = [
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/youssef-qteishat/",
    icon: "fa-brands fa-linkedin-in fa-fw",
  },
  {
    name: "GitHub",
    href: "https://github.com/youssef-qteishat",
    icon: "fa-brands fa-github fa-fw",
  },
  {
    name: "Email",
    href: "mailto:youssef.qt1@gmail.com",
    icon: "fa-solid fa-envelope fa-fw",
  },
];
---

<footer>
  <nav>
    {
      links.map(({ name, href, icon }) => (
        <a
          href={href}
          aria-label={name}
          target={href.startsWith("http") ? "_blank" : undefined}
          rel="noopener noreferrer"
        >
          <i class={icon} aria-hidden="true" />
        </a>
      ))
    }
  </nav>
</footer>

<script>
  document.querySelectorAll<HTMLAnchorElement>("nav a").forEach((link) => {
    const icon = link.querySelector("i");
    if (!icon) return;

    // Float while hovered or keyboard-focused
    const start = () => icon.classList.add("fa-float");
    const stop = () => icon.classList.remove("fa-float");
    link.addEventListener("mouseenter", start);
    link.addEventListener("mouseleave", stop);
    link.addEventListener("focus", start);
    link.addEventListener("blur", stop);

    // Bounce once on click
    link.addEventListener("click", () => {
      icon.classList.remove("fa-float", "fa-bounce");
      void icon.offsetWidth; // restart the animation if clicked repeatedly
      icon.classList.add("fa-bounce");
    });

    // After the bounce, drop the class and resume floating if still hovered
    icon.addEventListener("animationend", () => {
      icon.classList.remove("fa-bounce");
      if (link.matches(":hover, :focus-visible")) start();
    });
  });
</script>

<style>
  footer {
    text-align: center;
    padding: 1.5rem 0;
    background-color: #010736;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
  }
  nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  nav a,
  nav a:visited {
    color: #fcf1d0;
    font-size: 1.5rem; /* same 24px as the old PNGs */
  }

  nav a:hover,
  nav a:active {
    color: #8acff8;
  }

  i.fa-bounce {
    --fa-animation-iteration-count: 1;
  }
</style>
